<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/macsuite-tests.log</file>
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>target/logs/macsuite-tests-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Step definitions: INFO — shows scenario-level progress in console -->
    <logger name="com.macsuite.bct.steps" level="INFO" />
    <logger name="com.macsuite.access_control.steps" level="INFO" />
    <logger name="com.macsuite.vendor_engagement.steps" level="INFO" />
    <logger name="com.macsuite.hiring_metrics.steps" level="INFO" />
    <logger name="com.macsuite.pier.steps" level="INFO" />
    <logger name="com.macsuite.pra.steps" level="INFO" />
    <logger name="com.macsuite.outreach.steps" level="INFO" />
    <logger name="com.macsuite.inquiry_tracker.steps" level="INFO" />
    <logger name="com.macsuite.common.steps" level="INFO" />
    <logger name="com.macsuite.common.hooks" level="INFO" />

    <!-- Page objects and utilities: INFO — enable detailed logging -->
    <logger name="com.macsuite" level="INFO" />
    <logger name="com.microsoft.playwright" level="WARN" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
