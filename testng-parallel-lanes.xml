    <test name="Regression Lane 1">
        <classes>
            <class name="com.macsuite.runners.RestLaneOneRunner" />
        </classes>
    </test>

    <test name="Regression Lane 2">
        <classes>
            <class name="com.macsuite.runners.RestLaneTwoRunner" />
        </classes>
    </test>
</suite>